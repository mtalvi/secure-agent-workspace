{
  "apiVersion": "node.k8s.io/v1",
  "kind": "RuntimeClass",
  "metadata": {
    "name": "saw-kata",
    "labels": {
      "openshell.ai/sandbox-attachable": "true"
    }
  },
  "handler": "kata",
  "overhead": {
    "podFixed": {
      "cpu": "250m",
      "memory": "350Mi"
    }
  },
  "scheduling": {
    "nodeSelector": {
      "feature.node.kubernetes.io/runtime.kata": "true",
      "node-role.kubernetes.io/kata-oc": ""
    }
  }
}
